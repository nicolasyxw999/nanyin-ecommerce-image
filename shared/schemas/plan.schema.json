{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plan",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "coordinator",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "job_id": {
      "type": "string"
    },
    "coordinator": {
      "type": "string"
    },
    "assets": {
      "type": "array",
      "minItems": 1
    },
    "provider": {
      "enum": [
        "codex_builtin",
        "qwen",
        "volcengine"
      ],
      "default": "codex_builtin"
    }
  }
}
